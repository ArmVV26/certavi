{
  "name": "certavi",
  "private": true,
  "version": "0.10.1",
  "description": "Offline-first PWA to log strength training: routines, sessions, sets, progress and mobility blocks.",
  "type": "module",
  "license": "UNLICENSED",
  "author": "Armando Vaquero Vargas",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run --reporter=dot",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --reporter=dot",
    "e2e": "playwright test --project=chromium",
    "e2e:all": "playwright test --global-timeout=1600000",
    "e2e:timings": "node scripts/e2e-timings.mjs",
    "knip": "knip",
    "icons": "pwa-assets-generator",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ports:check": "node scripts/ports-check.mjs",
    "ports:kill": "kill-port 5173 4173 8888 8787 9323",
    "prepare": "husky"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@netlify/blobs": "11.1.8",
    "dexie": "4.4.7",
    "dexie-react-hooks": "4.4.0",
    "i18next": "27.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "18.0.1",
    "react-router": "8.5.1",
    "workbox-window": "7.4.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "9.39.5",
    "@netlify/functions": "6.1.1",
    "@playwright/test": "1.65.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.9",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vite-pwa/assets-generator": "2.0.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "fake-indexeddb": "6.2.8",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "jsdom": "31.0.0",
    "kill-port": "2.0.1",
    "knip": "6.44.2",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.7",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.0"
  }
}
