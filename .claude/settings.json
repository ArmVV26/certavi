{
  "model": "opusplan",
  "permissions": {
    "deny": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git tag:*)",
      "Bash(git reset --hard:*)",
      "Bash(git checkout -b:*)",
      "Bash(git switch -c:*)",
      "Bash(git branch -d:*)",
      "Bash(git branch -D:*)",
      "Bash(npm install -g:*)",
      "Bash(npx playwright install:*)",
      "Bash(npx playwright show-report:*)",
      "PowerShell(git commit:*)",
      "PowerShell(git push:*)",
      "PowerShell(git merge:*)",
      "PowerShell(git rebase:*)",
      "PowerShell(git tag:*)",
      "PowerShell(git reset --hard:*)",
      "PowerShell(git checkout -b:*)",
      "PowerShell(git switch -c:*)",
      "PowerShell(git branch -d:*)",
      "PowerShell(git branch -D:*)",
      "PowerShell(npm install -g:*)",
      "PowerShell(npx playwright install:*)",
      "PowerShell(npx playwright show-report:*)",
      "Read(./.env*)",
      "Read(./backups/**)",
      "Read(./package-lock.json)",
      "Read(./playwright-report/**)",
      "Read(./coverage/**)",
      "Read(./dist/**)"
    ],
    "ask": [
      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Bash(npm uninstall:*)",
      "Bash(npm update:*)",
      "Bash(npx netlify:*)",
      "PowerShell(npm install:*)",
      "PowerShell(npm i:*)",
      "PowerShell(npm uninstall:*)",
      "PowerShell(npm update:*)",
      "PowerShell(npx netlify:*)"
    ],
    "allow": [
      "Bash(npm run lint:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npm run test:*)",
      "Bash(npm run build:*)",
      "Bash(npm run e2e:*)",
      "Bash(npm run ports:*)",
      "Bash(npm run format:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(npm audit:*)",
      "PowerShell(npm run lint:*)",
      "PowerShell(npm run typecheck:*)",
      "PowerShell(npm run test:*)",
      "PowerShell(npm run build:*)",
      "PowerShell(npm run e2e:*)",
      "PowerShell(npm run ports:*)",
      "PowerShell(npm run format:*)",
      "PowerShell(git status:*)",
      "PowerShell(git diff:*)",
      "PowerShell(git log:*)",
      "PowerShell(npm audit:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/hooks/format-file.mjs\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/hooks/ports-warn.mjs\""
          }
        ]
      }
    ]
  }
}
