{
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npm run test)",
      "Bash(npm run test *)",
      "Bash(npm run test:coverage)",
      "Bash(npm run build)",
      "Bash(npm run e2e)",
      "Bash(npm run e2e *)",
      "Bash(npm run e2e:all)",
      "Bash(npm run e2e:timings)",
      "Bash(npm run e2e:timings *)",
      "Bash(npm run ports:check)",
      "Bash(npm run ports:kill)",
      "Bash(npm run format)",
      "Bash(npm run format:check)",
      "Bash(npm run knip)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(npm audit:*)",
      "Bash(git remote -v)",
      "Bash(gh --version)",
      "PowerShell(npm run lint)",
      "PowerShell(npm run typecheck)",
      "PowerShell(npm run test)",
      "PowerShell(npm run test *)",
      "PowerShell(npm run test:coverage)",
      "PowerShell(npm run build)",
      "PowerShell(npm run e2e)",
      "PowerShell(npm run e2e *)",
      "PowerShell(npm run e2e:all)",
      "PowerShell(npm run e2e:timings)",
      "PowerShell(npm run e2e:timings *)",
      "PowerShell(npm run ports:check)",
      "PowerShell(npm run ports:kill)",
      "PowerShell(npm run format)",
      "PowerShell(npm run format:check)",
      "PowerShell(npm run knip)",
      "PowerShell(git status:*)",
      "PowerShell(git diff:*)",
      "PowerShell(git log:*)",
      "PowerShell(npm audit:*)",
      "PowerShell(git remote -v)",
      "PowerShell(gh --version)"
    ],
    "deny": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git tag:*)",
      "Bash(git reset --hard:*)",
      "Bash(git checkout -b:*)",
      "Bash(git switch -c:*)",
      "Bash(git branch -d:*)",
      "Bash(git branch -D:*)",
      "Bash(git * push*)",
      "Bash(git * commit*)",
      "Bash(git * merge*)",
      "Bash(git * rebase*)",
      "Bash(git clean *)",
      "Bash(npm install -g:*)",
      "Bash(npx playwright install:*)",
      "Bash(npx playwright show-report:*)",
      "PowerShell(git commit:*)",
      "PowerShell(git push:*)",
      "PowerShell(git merge:*)",
      "PowerShell(git rebase:*)",
      "PowerShell(git tag:*)",
      "PowerShell(git reset --hard:*)",
      "PowerShell(git checkout -b:*)",
      "PowerShell(git switch -c:*)",
      "PowerShell(git branch -d:*)",
      "PowerShell(git branch -D:*)",
      "PowerShell(git * push*)",
      "PowerShell(git * commit*)",
      "PowerShell(git * merge*)",
      "PowerShell(git * rebase*)",
      "PowerShell(git clean *)",
      "PowerShell(npm install -g:*)",
      "PowerShell(npx playwright install:*)",
      "PowerShell(npx playwright show-report:*)",
      "Read(./.env*)",
      "Read(./**/.env*)",
      "Read(./backups/**)",
      "Read(./package-lock.json)",
      "Read(./playwright-report/**)",
      "Read(./coverage/**)",
      "Read(./dist/**)"
    ],
    "ask": [
      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Bash(npm uninstall:*)",
      "Bash(npm update:*)",
      "Bash(npx netlify:*)",
      "PowerShell(npm install:*)",
      "PowerShell(npm i:*)",
      "PowerShell(npm uninstall:*)",
      "PowerShell(npm update:*)",
      "PowerShell(npx netlify:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/hooks/format-file.mjs\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/hooks/ports-warn.mjs\""
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "armando-base@armando": true
  }
}
