# Normalize every text file to LF, in the repo and in the working tree (Windows included).
* text=auto eol=lf

# Binary files: never touch line endings or diff them as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.pdf binary
*.zip binary
